<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#FFF57C00</color>
    <color name="ic_launcher_foreground">@android:color/white</color>
    <color name="petal_pink">#FFF48FB1</color>
    <color name="petal_center">#FFFFD54F</color>
    <color name="route_line">#CC1E88E5</color>
    <color name="orbit_circle">#334CAF50</color>
    <color name="home_marker">#FFE53935</color>
    <!-- Big Flowers found by the bird's-eye scan, before they become route waypoints. -->
    <color name="scan_marker">#FFFF8F00</color>

    <!-- Floating control bar (ui/OverlayService). An overlay window has no activity theme, so these
         must be explicit and identical in light and dark mode. -->
    <color name="overlay_bg">#E62A2C30</color>
    <color name="overlay_text">#FFFFFFFF</color>
    <color name="overlay_icon">#FFFFFFFF</color>
    <color name="overlay_ripple">#40FFFFFF</color>
    <color name="overlay_phase_normal">#FF43A047</color>
    <color name="overlay_phase_paused">#FFFFB300</color>
    <color name="overlay_phase_returning">#FF1E88E5</color>
    <color name="overlay_phase_error">#FFE53935</color>
    <color name="overlay_phase_idle">#FF757575</color>
    <color name="overlay_phase_parked">#FF8E24AA</color>
    <color name="overlay_phase_manual">#FF00897B</color>

    <!-- Floating joystick (ui/JoystickView), also an overlay window. -->
    <color name="joystick_base">#8A2A2C30</color>
    <color name="joystick_ring">#B3FFFFFF</color>
    <color name="joystick_knob">#E6FFFFFF</color>
</resources>
