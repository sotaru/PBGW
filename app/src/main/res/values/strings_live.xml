    <string name="toast_home_custom_cleared">已改回：以真實位置當作家</string>
    <string name="toast_home_coords_invalid">座標格式不對，請用「緯度, 經度」</string>
    <string name="toast_home_locked">巡邏中無法更改家的位置，請先停止</string>
